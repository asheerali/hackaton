# Copy to .env and fill in what you have. docker-compose.yml and `python -m airframe serve`
# both read these from the environment; docker compose also auto-loads a .env file in this
# directory. Everything here is optional - with nothing set, Parts 2/3 run the offline
# catalog playbook/heuristic instead of an LLM.

# --- provider selection -----------------------------------------------------
# auto (default) picks the best available provider: openrouter (DeepSeek) > claude > offline.
# Set explicitly to pin one instead of auto-detecting from the keys below.
AIRFRAME_AGENT_MODE=auto

# --- OpenRouter / DeepSeek (preferred provider when set) --------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
AIRFRAME_OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Claude / Anthropic (used if no OpenRouter key is set) ------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AIRFRAME_MODEL=claude-opus-5

# --- misc ---------------------------------------------------------------
# Fixes the MAC-hashing salt across restarts so masked device ids stay stable.
# Leave unset to auto-generate one into .airframe_salt on first run.
AIRFRAME_SALT=
AIRFRAME_AUTOSTART=1
